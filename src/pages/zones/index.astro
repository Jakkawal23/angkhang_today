---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { AREAS, AREA_KEYS } from '../../data/areas';
import { breadcrumbLd } from '../../lib/seo';
import { getStays, getZones } from '../../lib/stays';

const [zones, stays] = await Promise.all([getZones(), getStays()]);
const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'เส้นทางและหมู่บ้าน', href: '/zones' },
];
const count = (id: string) => stays.filter((s) => s.data.zone.id === id).length;
const groups = AREA_KEYS.map((key) => ({ key, area: AREAS[key], zones: zones.filter((z) => z.data.area === key) }));
---

<Base
  title="เส้นทางขึ้นดอยอ่างขางและหมู่บ้าน เลือกที่พักตามเส้นทาง"
  description="ขึ้นดอยอ่างขางได้ 3 เส้นทาง: ทล.1249 แม่งอน (ฝาง), ทล.1178 อรุโณทัย (เชียงดาว) และเส้นบ้านใหม่หนองบัว (ไชยปราการ) เลือกที่พักบนดอยหรือตามหมู่บ้านบนเส้นทาง เช่น บ้านยาง บ้านผาแดง บ้านสินชัย บ้านอรุโณทัย"
  jsonLd={breadcrumbLd(crumbs)}
>
  <div class="container-page space-y-10 py-8">
    <Breadcrumbs items={crumbs} />
    <header>
      <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">เส้นทางขึ้นดอยอ่างขางและหมู่บ้าน</h1>
      <p class="mt-2 max-w-3xl text-slate-600">
        <strong>คำตอบสั้น:</strong> ขึ้นดอยอ่างขางได้ 3 เส้นทาง — <strong>ทล.1249</strong> จากฝั่งฝาง (ผ่านบ้านยาง ชันที่สุด),
        <strong>ทล.1178</strong> จากบ้านอรุโณทัย อ.เชียงดาว (ผ่านบ้านสินชัย บ้านผาแดง ชันน้อยกว่า) และ<strong>เส้นบ้านใหม่หนองบัว</strong> จากฝั่งไชยปราการ
        ที่ไปเชื่อม ทล.1178 ที่บ้านสินชัย
      </p>
    </header>

    {
      groups.map((g) => (
        <section>
          <a href={`/routes/${g.key}`} class="group mb-4 flex flex-wrap items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-pine-700 text-white">
              <Icon name={g.area.icon} class="h-5 w-5" />
            </span>
            <span>
              <span class="section-title block group-hover:text-pine-700">{g.area.name}</span>
              <span class="block text-sm text-slate-600">{g.area.summary}</span>
            </span>
          </a>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {g.zones.map((z) => (
              <a href={`/zones/${z.id}`} class="card group block p-5 transition hover:border-pine-300 hover:shadow-md">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-pine-700">{z.data.name}</h3>
                  <span class="shrink-0 rounded-full bg-pine-50 px-2 py-0.5 text-xs font-semibold text-pine-700">{count(z.id)} ที่พัก</span>
                </div>
                <p class="text-xs text-slate-400">
                  {z.data.nameEn}
                  {z.data.district && ` · อ.${z.data.district}`}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{z.data.summary}</p>
                <p class="mt-3 flex flex-wrap gap-1">
                  {z.data.goodFor.map((t) => (
                    <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{t}</span>
                  ))}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
