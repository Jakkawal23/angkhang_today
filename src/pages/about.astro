---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../lib/seo';
import { SITE } from '../data/site';

const crumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'เกี่ยวกับเรา', href: '/about' },
];
---

<Base title="เกี่ยวกับเรา" description="Angkhang Today (อ่างขาง ทูเดย์) รวมที่พักดอยอ่างขางพร้อมช่องทางติดต่อที่ตรวจสอบแล้ว เพื่อให้นักท่องเที่ยวหาที่พักได้ง่ายและปลอดภัยจากมิจฉาชีพ" jsonLd={breadcrumbLd(crumbs)}>
  <article class="container-page max-w-3xl space-y-6 py-8">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">เกี่ยวกับ {SITE.name}</h1>
    <div class="prose-content">
      <p>
        <strong>{SITE.name} ({SITE.nameTh})</strong> คือเว็บรวมที่พักบนดอยอ่างขาง อ.ฝาง จ.เชียงใหม่ ที่ตั้งใจแก้ 2 ปัญหาหลักของนักท่องเที่ยว:
      </p>
      <ul>
        <li><strong>หาที่พักยาก</strong> — ที่พักบนดอยหลายแห่งไม่ได้อยู่บนแอปจองโรงแรม ทำให้ต้องโพสต์หาห้องในกลุ่ม Facebook แล้วรอคนมาตอบ</li>
        <li><strong>มิจฉาชีพและเพจปลอม</strong> — โดยเฉพาะช่วงหน้าหนาวที่ห้องเต็ม มีเพจปลอมแอบอ้างชื่อที่พักหลอกให้โอนมัดจำ</li>
      </ul>
      <h2>เครื่องหมาย "การันตีช่องทางติดต่อ" ได้มาอย่างไร</h2>
      <p>ทีมงานจะตรวจสอบอย่างน้อยดังนี้ ก่อนให้เครื่องหมายการันตี:</p>
      <ol>
        <li>ยืนยันตัวตนเจ้าของที่พัก (พบตัวที่พักหรือวิดีโอคอลที่หน้าที่พัก)</li>
        <li>ตรวจว่าชื่อบัญชีรับโอนตรงกับเจ้าของหรือนิติบุคคลของที่พัก</li>
        <li>โทรยืนยันเบอร์โทร และทดสอบทัก LINE / เพจ ว่าเป็นของที่พักจริง</li>
        <li>ทบทวนข้อมูลซ้ำเป็นระยะ และถอดเครื่องหมายทันทีหากพบความผิดปกติ</li>
      </ol>
      <p>เครื่องหมายนี้รับรอง <strong>ช่องทางติดต่อ</strong> เท่านั้น ไม่ได้รับรองคุณภาพห้องพักหรือการบริการ</p>
      <h2>เราหารายได้อย่างไร</h2>
      <p>ช่วงแรกเว็บไซต์ให้บริการฟรีทั้งนักท่องเที่ยวและเจ้าของที่พัก เราไม่รับเงินจองแทนที่พัก การชำระเงินทั้งหมดทำกับเจ้าของที่พักโดยตรง</p>
      <h2>ติดต่อเรา</h2>
      <p>LINE: {SITE.contact.line} · อีเมล: {SITE.contact.email}</p>
    </div>
  </article>
</Base>
