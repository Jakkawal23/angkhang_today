---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import SearchForm from '../components/SearchForm.astro';
import StayCard from '../components/StayCard.astro';
import { SITE } from '../data/site';
import { SITE_FAQS } from '../data/faqs';
import { AMENITIES, type Amenity } from '../data/amenities';
import type { IconName } from '../lib/icons';
import { AREAS, AREA_KEYS } from '../data/areas';
import { faqLd, websiteLd } from '../lib/seo';
import { getStays, getZoneNames, getZones } from '../lib/stays';

const stays = await getStays();
const zones = await getZones();
const zoneNames = await getZoneNames();
// ยังไม่มีที่พักการันตี -> แสดงที่พักที่มีข้อมูลครบที่สุดแทน
const verifiedStays = stays.filter((s) => s.data.verified.status);
const featured = (verifiedStays.length ? verifiedStays : stays).slice(0, 6);
const countByZone = (id: string) => stays.filter((s) => s.data.zone.id === id).length;
const verifiedCount = stays.filter((s) => s.data.verified.status).length;
const groups = AREA_KEYS.map((key) => {
  const list = zones.filter((z) => z.data.area === key);
  return { key, area: AREAS[key], zones: list, total: list.reduce((n, z) => n + countByZone(z.id), 0) };
});

// ทางลัดตามความต้องการที่คนมักโพสต์ถามในกลุ่ม
const quick: { label: string; href: string; icon: IconName }[] = [
  { label: 'ที่พักบนดอย', icon: 'mountain', href: '/routes/top' },
  { label: 'เส้น 1178 อรุโณทัย–ผาแดง', icon: 'route', href: '/routes/r1178' },
  { label: 'มี LINE ให้ติดต่อ', icon: 'line', href: '/stays?line=1' },
  // แสดงเฉพาะคุณสมบัติที่มีที่พักอยู่จริง
  ...(['mist-view', 'bbq-grill', 'large-group', 'pet-friendly', 'heater', 'breakfast', 'family', 'walk-to-station'] as Amenity[])
    .filter((k) => stays.some((st) => st.data.amenities.includes(k)))
    .map((k) => ({
    label: AMENITIES[k].label,
    icon: AMENITIES[k].icon,
    href: `/stays/tag/${k}`,
  })),
  { label: 'ลานกางเต็นท์', icon: 'tent', href: '/stays/type/tent' },
  { label: 'งบไม่เกิน 1,000', icon: 'wallet', href: '/stays?budget=1000' },
];

const oldWay = [
  'ต้องโพสต์วันที่ จำนวนคน งบ แล้วรอคนมาตอบ',
  'คอมเมนต์เป็นร้อย ไล่อ่านไม่ไหว เทียบราคายาก',
  'มิจฉาชีพแฝงตัวมาตอบ ส่งเพจปลอมทักแชต',
  'ไม่รู้ว่าบัญชีรับโอนเป็นของเจ้าของจริงไหม',
];
const newWay = [
  'กรองตามโซน เส้นทาง งบ จำนวนคน และสิ่งที่ต้องการได้ในไม่กี่วินาที',
  'ทุกที่พักมีหน้าเว็บของตัวเอง ห้อง ราคา แผนที่ ครบในหน้าเดียว',
  'เครื่องหมายการันตี = เบอร์ / LINE / ชื่อบัญชี ตรวจสอบแล้ว',
  'กดทักเจ้าของได้ทันที พร้อมข้อความถามห้องว่างที่ระบบเตรียมให้',
];
---

<Base title={`ที่พักดอยอ่างขาง ค้นหาง่าย ติดต่อตรง ปลอดภัยจากเพจปลอม | ${SITE.name}`} fullTitle jsonLd={[...websiteLd(), faqLd(SITE_FAQS)]}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-b from-pine-800 via-pine-700 to-pine-600 text-white">
    <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-40 w-full sm:h-56" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 220V120l160-70 140 80 200-110 180 100 160-60 220 90 180-70 200 80v80z" fill="rgba(255,255,255,.07)"></path>
      <path d="M0 220v-50l220-60 200 70 240-80 220 70 260-60 300 70v40z" fill="rgba(255,255,255,.1)"></path>
    </svg>
    <div class="container-page relative pt-10 pb-24 sm:pt-16 sm:pb-32">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-medium ring-1 ring-white/20">
        <Icon name="shield-check" class="h-4 w-4 text-sakura-100" />
        ช่องทางติดต่อตรวจสอบแล้ว · ติดต่อเจ้าของโดยตรง · ไม่มีค่าธรรมเนียม
      </p>
      <h1 class="max-w-3xl text-3xl leading-tight font-extrabold sm:text-5xl sm:leading-tight">
        หาที่พัก<span class="text-sakura-100">ดอยอ่างขาง</span>ที่ใช่<br class="hidden sm:block" />
        ไม่ต้องโพสต์หา ไม่โดนเพจปลอม
      </h1>
      <p class="mt-4 max-w-2xl text-pine-100 sm:text-lg">
        เลือกเส้นทางขึ้นดอยหรือหมู่บ้าน วันที่ จำนวนคน และสิ่งที่อยากได้ เช่น วิวทะเลหมอก หมูกระทะ รับกรุ๊ป แล้วทักเจ้าของที่พักได้ทันทีด้วยข้อความที่ระบบเตรียมไว้ให้
      </p>
    </div>
  </section>

  <div class="container-page relative z-10 -mt-16 sm:-mt-20">
    <SearchForm />
    <div class="mt-4 flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none]" aria-label="ค้นหาด่วน">
      {
        quick.map((q) => (
          <a href={q.href} class="chip shrink-0 hover:border-pine-500 hover:text-pine-700">
            <Icon name={q.icon} class="h-4 w-4 text-pine-600" />
            {q.label}
          </a>
        ))
      }
    </div>
  </div>

  <!-- ปัญหา -> ทางแก้ -->
  <section class="container-page mt-12">
    <h2 class="section-title">ไม่ต้องโพสต์หาห้องในกลุ่ม แล้วรอลุ้นอีกต่อไป</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="card border-dashed bg-slate-50 p-5">
        <p class="mb-3 text-sm font-bold text-slate-500">แบบเดิม: โพสต์หาในกลุ่ม Facebook</p>
        <ul class="space-y-2 text-sm text-slate-600">
          {oldWay.map((t) => <li class="flex gap-2"><Icon name="circle-x" class="mt-0.5 h-4 w-4 shrink-0 text-slate-400" />{t}</li>)}
        </ul>
      </div>
      <div class="card border-pine-200 bg-pine-50 p-5">
        <p class="mb-3 text-sm font-bold text-pine-700">Angkhang Today</p>
        <ul class="space-y-2 text-sm text-pine-900">
          {newWay.map((t) => <li class="flex gap-2"><Icon name="circle-check" class="mt-0.5 h-4 w-4 shrink-0 text-pine-600" />{t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ที่พักแนะนำ -->
  <section class="container-page mt-14">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="section-title">{verifiedCount ? 'ที่พักการันตีช่องทางติดต่อ' : 'ที่พักแนะนำ'}</h2>
        <p class="mt-1 text-sm text-slate-600">
          {verifiedCount ? `ตรวจสอบแล้ว ${verifiedCount} แห่ง จากทั้งหมด ${stays.length} แห่ง` : `รวม ${stays.length} แห่ง (ข้อมูลตัวอย่างจากแหล่งสาธารณะ ยังไม่ได้ยืนยันกับที่พัก)`}
        </p>
      </div>
      <a href="/stays" class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-pine-700 hover:underline">
        ดูทั้งหมด <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((s) => <StayCard stay={s} zoneName={zoneNames[s.data.zone.id]} />)}
    </div>
  </section>

  <!-- เส้นทางขึ้นดอย -->
  <section class="container-page mt-14">
    <h2 class="section-title">หาที่พักตามเส้นทางขึ้นดอยอ่างขาง</h2>
    <p class="mt-1 text-sm text-slate-600">ขึ้นดอยได้ 3 เส้นทาง เลือกพักบนดอย หรือแวะพักหมู่บ้านระหว่างทางที่คุณใช้เดินทาง</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        groups.map((g) => (
          <div class="card flex flex-col p-5">
            <a href={`/routes/${g.key}`} class="group flex gap-4">
              <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-white', g.key === 'top' ? 'bg-sakura-500' : 'bg-pine-700']}>
                <Icon name={g.area.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="font-bold text-slate-900 group-hover:text-pine-700">{g.area.name}</span>
                  <span class="rounded-full bg-pine-50 px-2 py-0.5 text-xs font-semibold text-pine-700">{g.total} ที่พัก</span>
                </span>
                <span class="mt-1 block text-sm text-slate-600">{g.area.summary}</span>
              </span>
            </a>
            <div class="mt-4 flex flex-wrap gap-1.5 border-t border-slate-100 pt-3">
              {g.zones.map((z) => (
                <a href={`/zones/${z.id}`} class="chip text-xs hover:border-pine-500">
                  <Icon name="map-pin" class="h-3.5 w-3.5 text-pine-600" />
                  {z.data.name}
                  <span class="text-slate-400">{countByZone(z.id)}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ตรวจสอบก่อนโอน -->
  <section class="container-page mt-14">
    <div class="overflow-hidden rounded-3xl bg-gradient-to-br from-sakura-500 to-sakura-600 p-6 text-white sm:p-10">
      <div class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-center">
        <div class="flex gap-4">
          <span class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15 sm:flex">
            <Icon name="shield-check" class="h-7 w-7" />
          </span>
          <div>
            <h2 class="text-2xl font-extrabold">ก่อนโอนมัดจำ เช็กให้ชัวร์</h2>
            <p class="mt-2 text-sakura-50">มีคนส่งเบอร์ LINE หรือเลขบัญชีมาให้โอน? วางลงช่องนี้เพื่อตรวจว่าตรงกับช่องทางที่เราการันตีหรือไม่</p>
          </div>
        </div>
        <form action="/verify" method="get" class="flex flex-col gap-2 sm:flex-row">
          <label for="home-verify" class="sr-only">เบอร์โทร LINE ID ลิงก์เพจ หรือเลขบัญชี</label>
          <input id="home-verify" name="q" required placeholder="เบอร์ / LINE ID / ลิงก์เพจ / เลขบัญชี" class="field flex-1 border-0" />
          <button class="btn bg-white text-sakura-600 hover:bg-sakura-50">ตรวจสอบ</button>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ (AEO) -->
  <section class="container-page mt-14">
    <h2 class="section-title">คำถามที่พบบ่อยเรื่องที่พักดอยอ่างขาง</h2>
    <div class="mt-6"><FaqList faqs={SITE_FAQS.slice(0, 5)} /></div>
    <a href="/faq" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-pine-700 hover:underline">
      ดูคำถามทั้งหมด <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </section>

  <!-- เจ้าของที่พัก -->
  <section class="container-page mt-14">
    <div class="card flex flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center">
      <div class="flex gap-4">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-pine-50 text-pine-700">
          <Icon name="building" class="h-6 w-6" />
        </span>
        <div>
          <h2 class="text-lg font-bold text-slate-900">เป็นเจ้าของที่พักบนดอยอ่างขาง?</h2>
          <p class="text-sm text-slate-600">รับหน้าเว็บที่พักของคุณเองฟรี พร้อมเครื่องหมายการันตี ลดปัญหาเพจปลอมแอบอ้างชื่อที่พัก</p>
        </div>
      </div>
      <a href="/for-owners" class="btn-primary shrink-0">ลงข้อมูลที่พักฟรี</a>
    </div>
  </section>
</Base>
