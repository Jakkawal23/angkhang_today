---
// โลโก้ Angkhang Today — สัญลักษณ์จาก src/data/logo-traced.json (ชุดเดียวกับไฟล์ใน public/brand/)
import logo from '../data/logo-traced.json';

interface Props {
  class?: string;
  light?: boolean;
}
const { class: className = '', light = false } = Astro.props;
const main = light ? '#FFFFFF' : logo.green.color;
---

<a href="/" class:list={['flex items-center gap-2', className]} aria-label="Angkhang Today หน้าแรก">
  <svg viewBox={`0 0 ${logo.width} ${logo.height}`} class="h-10 w-auto shrink-0" aria-hidden="true">
    <path fill-rule="evenodd" fill={main} d={logo.green.d}></path>
    <path fill-rule="evenodd" fill={logo.pink.color} d={logo.pink.d}></path>
  </svg>
  <span class="leading-none">
    <span class="block text-[15px] font-extrabold tracking-tight" style={`color:${light ? '#FFFFFF' : logo.green.color}`}>Angkhang</span>
    <span class="block text-[15px] font-extrabold tracking-tight" style={`color:${light ? '#F4B6CA' : logo.pink.color}`}>Today</span>
  </span>
</a>
