---
import Icon from './Icon.astro';
import type { Faq } from '../data/faqs';

interface Props {
  faqs: Faq[];
  /** ระดับหัวข้อของคำถาม */
  as?: 'h2' | 'h3';
}
const { faqs, as: Tag = 'h3' } = Astro.props;
---

<div class="divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white">
  {
    faqs.map((f, i) => (
      <details class="group p-4 sm:p-5" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
          <Tag class="font-semibold text-slate-900">{f.q}</Tag>
          <span class="mt-0.5 shrink-0 text-pine-600 transition group-open:rotate-180">
            <Icon name="chevron-down" />
          </span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
      </details>
    ))
  }
</div>
